    "axios": "^1.20.0",
    "date-fns": "^2.16.1",
    "rrweb": "^1.1.3",
    "tailwindcss": "^3.3.5",
    "vue": "^3.5.43",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/compiler-sfc": "^3.3.8",
    "@vue/eslint-config-typescript": "^12.0.0",
    "autoprefixer": "^10.6.1",
